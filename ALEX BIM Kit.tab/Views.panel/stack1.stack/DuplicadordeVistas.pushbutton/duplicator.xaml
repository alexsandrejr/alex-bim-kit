<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicador de Vistas"
        Width="450"
        Height="800"
        MinWidth="450"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Estilo para GroupBox -->
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Estilo para Botões -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- título -->
            <RowDefinition Height="*"/>    <!-- lista de vistas -->
            <RowDefinition Height="Auto"/> <!-- opções duplicação -->
            <RowDefinition Height="Auto"/> <!-- replace -->
            <RowDefinition Height="Auto"/> <!-- prefix/suffix -->
            <RowDefinition Height="Auto"/> <!-- botões -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Duplicar Vistas"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,12"
                   Foreground="#333333"/>

        <!-- LISTA DE VISTAS -->
        <GroupBox Grid.Row="1"
                  Header="Selecione as Vistas"
                  Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Botões de Seleção -->
                <StackPanel Grid.Row="0"
                           Orientation="Horizontal"
                           Margin="0,0,0,6">
                    <Button x:Name="selectAllBtn"
                            Content="Selecionar Todos"
                            Padding="8,4"
                            Margin="0,0,6,0"
                            FontSize="11"/>
                    <Button x:Name="selectNoneBtn"
                            Content="Limpar Seleção"
                            Padding="8,4"
                            FontSize="11"/>
                </StackPanel>

                <ListBox x:Name="viewslist"
                         Grid.Row="1"
                         MinHeight="180"
                         SelectionMode="Single"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="Dica: Clique duplo em uma vista para marcar/desmarcar"
                           FontSize="10"
                           FontStyle="Italic"
                           Foreground="#666666"
                           Margin="4,4,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Opções de duplicação -->
        <GroupBox Grid.Row="2"
                  Header="Modo de Duplicação"
                  Margin="0,0,0,12">
            <StackPanel Orientation="Vertical" Margin="4">
                <RadioButton x:Name="optDuplicate"
                             Content="Duplicate"
                             IsChecked="True"
                             Margin="0,4,0,4"
                             ToolTip="Duplica apenas a vista, sem anotações"/>
                <RadioButton x:Name="optWithDetail"
                             Content="Duplicate with Detailing"
                             Margin="0,4,0,4"
                             ToolTip="Duplica a vista com todas as anotações e detalhes"/>
                <RadioButton x:Name="optDependent"
                             Content="Duplicate as Dependent"
                             Margin="0,4,0,4"
                             ToolTip="Cria uma vista dependente da original"/>
            </StackPanel>
        </GroupBox>

        <!-- Replace From / To -->
        <GroupBox Grid.Row="3"
                  Header="Substituir Texto no Nome (opcional)"
                  Margin="0,0,0,12">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Substituir:"
                           Width="100"
                           VerticalAlignment="Center"
                           Margin="0,4,8,4"/>
                <TextBox x:Name="replaceFrom"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,4"
                         ToolTip="Texto que será substituído"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Por:"
                           Width="100"
                           VerticalAlignment="Center"
                           Margin="0,4,8,4"/>
                <TextBox x:Name="replaceTo"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,4"
                         ToolTip="Novo texto"/>
            </Grid>
        </GroupBox>

        <!-- Prefix / Suffix -->
        <GroupBox Grid.Row="4"
                  Header="Adicionar Prefixo / Sufixo (opcional)"
                  Margin="0,0,0,12">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Prefixo:"
                           Width="100"
                           VerticalAlignment="Center"
                           Margin="0,4,8,4"/>
                <TextBox x:Name="prefixTxt"
                         Grid.Row="0" Grid.Column="1"
                         Margin="0,4"
                         ToolTip="Texto adicionado no início do nome"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Sufixo:"
                           Width="100"
                           VerticalAlignment="Center"
                           Margin="0,4,8,4"/>
                <TextBox x:Name="suffixTxt"
                         Grid.Row="1" Grid.Column="1"
                         Margin="0,4"
                         ToolTip="Texto adicionado no final do nome"/>
            </Grid>
        </GroupBox>

        <!-- Botões -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="okbutton"
                    Width="120"
                    Height="32"
                    Margin="0,0,8,0"
                    Content="Duplicar"
                    Click="on_click_ok"
                    IsDefault="True"
                    FontWeight="SemiBold"/>
            <Button x:Name="cancelbutton"
                    Width="100"
                    Height="32"
                    Content="Cancelar"
                    Click="on_click_cancel"
                    IsCancel="True"/>
        </StackPanel>

    </Grid>
</Window>